{
  "name": "march-ext",
  "displayName": "March - Visual Architecture",
  "description": "Sketch backend and frontend architecture on a canvas -- drag typed shapes or hand-draw them -- and generate real, runnable code from it via your own coding agent CLI, whichever one you point it at.",
  "version": "0.1.2",
  "private": true,
  "publisher": "ArtemKrasnyi",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "resources/icon.png",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "march.open",
        "title": "March: Open",
        "category": "March"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "march",
          "title": "March",
          "icon": "resources/activity-bar-icon.png"
        }
      ]
    },
    "views": {
      "march": [
        {
          "id": "march.launcher",
          "name": "",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@march/spec-schema": "*",
    "@types/node": "^20.14.15",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.23.1",
    "typescript": "^5.5.4"
  }
}
